# ฐานข้อมูล: ไฟล์ SQLite ในเครื่อง (dev) หรือ Turso (production)
DATABASE_URL=file:./data/entech.db
DATABASE_AUTH_TOKEN=
# URL จริงของเว็บ (ใช้ใน sitemap, canonical, JSON-LD)
SITE_URL=http://localhost:3000
# สุ่มอย่างน้อย 32 ตัวอักษร: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# แอดมินคนแรก (ใช้ตอน npm run db:seed)
ADMIN_EMAIL=admin@entech.local
ADMIN_PASSWORD=
# API ระบบสต็อก/ERP (docs/STOCK-API.md) — เว้นว่าง = ปิด · สุ่ม 32+ ตัว: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STOCK_API_KEY=
