# ฐานข้อมูลของหลังบ้าน (แยกจากเว็บไซต์) — dev ใช้ไฟล์ในเครื่อง, production ใช้ Turso คนละฐานกับเว็บ
DATABASE_URL=file:./data/backoffice.db
DATABASE_AUTH_TOKEN=
# อย่างน้อย 32 ตัวอักษร
SESSION_SECRET=
ADMIN_EMAIL=admin@entech.local
ADMIN_PASSWORD=
# เชื่อมเว็บไซต์ผ่าน Stock API v1 (ดู entech-shop/docs/STOCK-API.md) — เว้นว่าง = ยังไม่เชื่อม
WEB_API_URL=https://testweb-azure-chi.vercel.app/api/v1
WEB_API_KEY=
# ให้ Vercel Cron เรียก /api/cron/sync (ตั้งค่าเดียวกันใน Vercel)
CRON_SECRET=
